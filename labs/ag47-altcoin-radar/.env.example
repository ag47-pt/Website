# Shared mode: demo | live
APP_ENV=development
DEMO_MODE=true
PROVIDER_MODE=demo

# Web (browser-visible; no secrets)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=pt-PT
NEXT_PUBLIC_USER_TIMEZONE=Europe/London

# API
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/ag47_radar.db
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Ingestion and scheduler
SCHEDULER_ENABLED=false
MARKET_SYNC_INTERVAL_SECONDS=300
ALERT_DEDUPLICATION_WINDOW_MINUTES=30
ENABLED_CHAINS=["bsc","solana","ethereum"]

# Public providers (no credentials required for the Sprint 1 adapters)
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
DEXSCREENER_BASE_URL=https://api.dexscreener.com
PROVIDER_CONNECT_TIMEOUT_SECONDS=3
PROVIDER_READ_TIMEOUT_SECONDS=8
PROVIDER_MAX_RETRIES=3
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_RECOVERY_SECONDS=60

# Docker PostgreSQL local defaults. Replace outside local development.
POSTGRES_DB=ag47_radar
POSTGRES_USER=ag47
POSTGRES_PASSWORD=ag47_local_only

