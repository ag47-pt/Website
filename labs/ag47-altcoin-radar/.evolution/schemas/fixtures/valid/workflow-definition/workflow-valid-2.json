{
  "schema_version": "1.0.0",
  "workflow_id": "wf-bug-fix",
  "name": "Bug Fix Cycle",
  "steps": [
    {
      "step_name": "reproduction",
      "role_required": "debugger",
      "inputs_required": [
        "bug_report"
      ],
      "outputs_produced": [
        "reproduction_script"
      ],
      "exit_conditions": [
        "script_fails_consistently"
      ]
    },
    {
      "step_name": "fix",
      "role_required": "executor",
      "inputs_required": [
        "reproduction_script"
      ],
      "outputs_produced": [
        "changeset"
      ]
    }
  ]
}