{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.com/schemas/governance/capability-policy.schema.json",
  "title": "Capability Policy",
  "description": "Autorização de uso de skills num contexto restrito (I am authorized).",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "capability_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "role_ref": { "type": "string" },
    "skill_refs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "allowed_contexts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "forbidden_contexts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "budget_limits": {
      "type": "object",
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 0 },
        "max_time_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "capability_id", "role_ref", "skill_refs", "allowed_contexts", "forbidden_contexts"],
  "additionalProperties": false
}
