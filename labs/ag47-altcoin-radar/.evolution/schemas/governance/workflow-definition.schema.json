{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.com/schemas/governance/workflow-definition.schema.json",
  "title": "Workflow Definition",
  "description": "Define a máquina de estados e o pipeline operacional de ponta a ponta.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "workflow_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_name": { "type": "string" },
          "role_required": { "type": "string" },
          "inputs_required": {
            "type": "array",
            "items": { "type": "string" }
          },
          "outputs_produced": {
            "type": "array",
            "items": { "type": "string" }
          },
          "exit_conditions": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["step_name", "role_required", "inputs_required", "outputs_produced"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["schema_version", "workflow_id", "name", "steps"],
  "additionalProperties": false
}
