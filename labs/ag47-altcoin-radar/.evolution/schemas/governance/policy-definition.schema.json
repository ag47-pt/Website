{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.com/schemas/governance/policy-definition.schema.json",
  "title": "Policy Definition",
  "description": "Regras de negócio e segurança que bloqueiam ou autorizam ações no protocolo.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "policy_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "rule": {
      "type": "string",
      "enum": ["ALLOW", "DENY", "REQUIRE_APPROVAL"]
    },
    "condition": { "type": "string" },
    "reason": { "type": "string" },
    "enforcement_level": {
      "type": "string",
      "enum": ["STRICT", "AUDIT_ONLY"]
    }
  },
  "required": ["schema_version", "policy_id", "name", "rule", "condition", "reason", "enforcement_level"],
  "additionalProperties": false
}
