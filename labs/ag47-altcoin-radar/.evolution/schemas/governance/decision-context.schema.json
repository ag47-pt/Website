{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.com/schemas/governance/decision-context.schema.json",
  "title": "Decision Context",
  "description": "Captura o motivo (o 'porquê') uma decisão foi tomada, preservando a memória da intenção.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "context_id": { "type": "string", "format": "uuid" },
    "trigger": { "type": "string" },
    "observations": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "alternatives_considered": {
      "type": "array",
      "items": { "type": "string" }
    },
    "chosen_path_ref": {
      "$ref": "https://ag47.protocol/schemas/common/artifact-reference"
    },
    "rejected_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rationale": { "type": "string" }
  },
  "required": ["schema_version", "context_id", "trigger", "observations", "constraints", "chosen_path_ref", "rationale"],
  "additionalProperties": false
}
