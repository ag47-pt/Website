{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.com/schemas/governance/skill-definition.schema.json",
  "title": "Skill Definition",
  "description": "Formaliza uma capacidade isolada que pode ser executada por um agente (I know how).",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "skill_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "objective": { "type": "string" },
    "inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tools_required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "boundaries": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cost_profile": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "test_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "version": { "type": "string" }
  },
  "required": ["schema_version", "skill_id", "name", "objective", "inputs", "outputs", "boundaries", "cost_profile", "test_criteria", "version"],
  "additionalProperties": false
}
