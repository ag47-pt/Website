{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.com/schemas/governance/knowledge-entry.schema.json",
  "title": "Knowledge Entry",
  "description": "Oficialização de aprendizados ou descobertas na base de memória definitiva do protocolo.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "entry_id": { "type": "string", "format": "uuid" },
    "source_verdict_ref": {
      "$ref": "https://ag47.protocol/schemas/common/artifact-reference"
    },
    "topic": { "type": "string" },
    "content": { "type": "string" },
    "confidence_level": {
      "type": "number",
      "enum": [0.0, 0.25, 0.5, 0.75, 1.0]
    },
    "valid_until": { "type": "string", "format": "date-time" },
    "promoted_by": {
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "signature": { "type": "string" }
      },
      "required": ["role", "signature"],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["CANDIDATE", "OFFICIAL", "DEPRECATED"]
    }
  },
  "required": ["schema_version", "entry_id", "source_verdict_ref", "topic", "content", "confidence_level", "promoted_by", "status"],
  "additionalProperties": false
}
