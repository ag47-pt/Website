{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.protocol/schemas/core/evolution-cycle",
  "title": "Evolution Cycle",
  "description": "The fundamental unit of evolution in the protocol, encapsulating a full state transition loop.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cycle_id": { "type": "string" },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["scheduled", "manual", "event_driven"]
        },
        "source": { "type": "string" },
        "intent": { "type": "string" }
      },
      "required": ["type", "source"]
    },
    "state_machine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current_state": {
          "type": "string",
          "enum": [
            "PENDING",
            "OBSERVING",
            "ANALYZING",
            "PLANNING",
            "REVIEWING",
            "EXECUTING",
            "VALIDATING",
            "LEARNING",
            "COMPLETED",
            "FAILED",
            "BLOCKED"
          ]
        },
        "retries": { "type": "integer", "minimum": 0 }
      },
      "required": ["current_state", "retries"]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initial_snapshot": { "type": "string" },
        "final_snapshot": { "type": "string" },
        "architecture_gap": { "type": "string" },
        "proposed_changeset": { "type": "string" },
        "execution_report": { "type": "string" },
        "integrity_verdict": { "type": "string" },
        "knowledge_entry": { "type": "string" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_agent_calls": { "type": "integer", "minimum": 1 },
        "max_retries": { "type": "integer", "minimum": 0 },
        "max_tokens": { "type": "integer", "minimum": 0 },
        "max_execution_time_minutes": { "type": "integer", "minimum": 1 }
      },
      "required": ["max_agent_calls", "max_retries"]
    },
    "agents": {
      "type": "object",
      "additionalProperties": true,
      "description": "Records the versions of the agents used during this cycle."
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "failure", "no_op", "rolled_back"]
        },
        "knowledge_generated": { "type": "boolean" },
        "reason": { "type": "string" }
      },
      "required": ["status", "knowledge_generated"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "cycle_id",
    "trigger",
    "state_machine",
    "artifacts",
    "agents",
    "started_at"
  ]
}
