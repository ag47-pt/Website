{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.protocol/schemas/core/architecture-gap",
  "title": "Architecture Gap Analysis",
  "description": "Traceable delta between the System Snapshot and Target Architecture.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "current_state": { "type": "string" },
          "target_state": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "category",
          "current_state",
          "target_state",
          "severity",
          "confidence",
          "evidence_refs"
        ]
      }
    }
  },
  "required": ["gaps"]
}
