{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.protocol/schemas/core/knowledge-entry",
  "title": "Knowledge Entry",
  "description": "Permanent record of an acquired learning, pattern, or constraint.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "knowledge_id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["engineering_pattern", "architectural_constraint", "operational_incident", "skill_enhancement"]
    },
    "statement": { "type": "string" },
    "lifecycle_state": {
      "type": "string",
      "enum": ["PROPOSED", "VALIDATED", "ACTIVE", "SUPERSEDED", "ARCHIVED"]
    },
    "source_evidence": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "learned_from": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": { "type": "string" },
        "agent": { "type": "string" },
        "execution_ref": { "type": "string" }
      },
      "required": ["agent"]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": { "type": "string" }
      },
      "required": ["scope"]
    },
    "supersedes": {
      "type": "string",
      "description": "The knowledge_id of the entry this replaces."
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "knowledge_id",
    "type",
    "statement",
    "lifecycle_state",
    "source_evidence",
    "confidence",
    "learned_from",
    "applicability"
  ]
}
