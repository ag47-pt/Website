{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.protocol/schemas/core/change-budget",
  "title": "Change Budget",
  "description": "Limits on modifications, cost, and complexity for a task.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "budget_id": { "type": "string", "format": "uuid" },
    "max_files_modified": { "type": "integer", "minimum": 0 },
    "max_lines_modified": { "type": "integer", "minimum": 0 },
    "max_dependencies_added": { "type": "integer", "minimum": 0 },
    "max_migrations": { "type": "integer", "minimum": 0 },
    "max_model_calls": { "type": "integer", "minimum": 0 },
    "max_tokens": { "type": "integer", "minimum": 0 },
    "max_cost_usd": { "type": "number", "minimum": 0 },
    "max_execution_time_ms": { "type": "integer", "minimum": 0 },
    "max_retries": { "type": "integer", "minimum": 0 }
  },
  "required": [
    "budget_id",
    "max_files_modified",
    "max_lines_modified",
    "max_dependencies_added",
    "max_migrations",
    "max_model_calls",
    "max_tokens",
    "max_cost_usd",
    "max_execution_time_ms",
    "max_retries"
  ]
}
