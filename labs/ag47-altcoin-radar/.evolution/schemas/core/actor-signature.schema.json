{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.protocol/schemas/core/actor-signature",
  "title": "Actor Signature",
  "description": "Structured record of authorship and approval linked to an artifact hash.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "signature_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_type": {
      "type": "string",
      "enum": ["HUMAN", "AI_AGENT", "SYSTEM"]
    },
    "actor_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "type": "string",
      "enum": ["CREATED", "MODIFIED", "APPROVED", "REJECTED", "VERIFIED"]
    },
    "target_resource": {
      "type": "string"
    },
    "artifact_hash": {
      "type": "string",
      "description": "Hash of the artifact being signed for integrity validation."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "signature_id",
    "actor_type",
    "actor_id",
    "timestamp",
    "action",
    "target_resource",
    "artifact_hash"
  ]
}
