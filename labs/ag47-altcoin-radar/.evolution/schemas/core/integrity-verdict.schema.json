{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.protocol/schemas/core/integrity-verdict",
  "title": "Integrity Verdict",
  "description": "Formal judgment of an execution's correctness and safety based on evidence.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict_id": { "type": "string" },
    "execution_ref": { "type": "string" },
    "changeset_ref": { "type": "string" },
    "verdict": {
      "type": "string",
      "enum": ["ALLOW", "DENY", "MANUAL_REVIEW_REQUIRED"]
    },
    "validation_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["scope", "hash_integrity", "acceptance_criteria", "tests", "static_analysis"]
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "unknown", "skipped"]
          },
          "details": { "type": "string" }
        },
        "required": ["type", "status"]
      }
    },
    "evidence_bundle": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "value": { "type": "string" },
          "source": { "type": "string" }
        },
        "required": ["type", "value", "source"]
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["code", "message"]
      }
    }
  },
  "required": [
    "verdict_id",
    "execution_ref",
    "changeset_ref",
    "verdict",
    "validation_layers",
    "evidence_bundle",
    "violations"
  ]
}
