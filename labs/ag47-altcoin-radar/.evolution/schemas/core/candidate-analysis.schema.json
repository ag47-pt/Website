{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.protocol/schemas/core/candidate-analysis",
  "title": "Candidate Analysis",
  "description": "The raw probabilistic output from the Cognitive Layer (LLM) before being parsed into the official architecture gap.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "observations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "The LLM's unstructured reasoning and interpretation of the snapshot."
    },
    "candidate_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "current_state": { "type": "string" },
          "target_state": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "category",
          "current_state",
          "target_state",
          "severity",
          "confidence",
          "evidence_refs"
        ]
      }
    }
  },
  "required": ["observations", "candidate_gaps"]
}
