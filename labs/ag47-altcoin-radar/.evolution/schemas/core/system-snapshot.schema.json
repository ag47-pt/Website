{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.protocol/schemas/core/system-snapshot",
  "title": "System Snapshot",
  "description": "Factual point-in-time record of repository architecture and environment.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "project_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string" },
        "language": { "type": "string" },
        "frameworks": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["os", "language", "frameworks"]
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "key_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "architecture_patterns": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["directories", "key_files", "architecture_patterns"]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "source": { "type": "string" }
        },
        "required": ["name", "version", "source"]
      }
    },
    "test_frameworks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          }
        },
        "required": ["type", "severity"]
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git_branch": { "type": "string" },
        "dirty": { "type": "boolean" }
      },
      "required": ["git_branch", "dirty"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_files": { "type": "integer" },
        "lines_of_code": { "type": "integer" }
      },
      "required": ["total_files", "lines_of_code"]
    }
  },
  "required": [
    "project_id",
    "timestamp",
    "environment",
    "architecture",
    "dependencies",
    "test_frameworks",
    "risks",
    "state",
    "metrics"
  ]
}
