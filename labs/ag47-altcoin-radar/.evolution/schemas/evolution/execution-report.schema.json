{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.protocol/schemas/evolution/execution-report",
  "title": "Execution Report",
  "description": "Factual record of execution actions, bounded by the changeset.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "execution_id": { "type": "string", "format": "uuid" },
    "active_task_ref": { "$ref": "https://ag47.protocol/schemas/common/artifact-reference" },
    "changeset_ref": { "$ref": "https://ag47.protocol/schemas/common/artifact-reference" },
    "executor_signature": { "$ref": "https://ag47.protocol/schemas/common/artifact-reference" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "commands_executed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files_created": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files_modified": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files_deleted": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies_added": {
      "type": "array",
      "items": { "type": "string" }
    },
    "migrations_applied": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tests_executed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "retries": { "type": "integer", "minimum": 0 },
    "human_actions_proposed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "budget_consumption": {
      "type": "object",
      "additionalProperties": true
    },
    "deviations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "produced_artifacts": {
      "type": "array",
      "items": { "$ref": "https://ag47.protocol/schemas/common/artifact-reference" }
    },
    "execution_status": {
      "type": "string",
      "enum": ["NOT_STARTED", "RUNNING", "COMPLETED", "PARTIAL", "BLOCKED", "FAILED", "ABORTED", "BUDGET_EXHAUSTED"]
    }
  },
  "required": [
    "execution_id", "active_task_ref", "changeset_ref", "executor_signature",
    "started_at", "budget_consumption", "execution_status"
  ]
}
