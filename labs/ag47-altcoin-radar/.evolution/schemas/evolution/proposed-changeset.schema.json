{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.protocol/schemas/evolution/proposed-changeset",
  "title": "Proposed Changeset",
  "description": "The approved execution contract with bounded scope.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "changeset_id": { "type": "string", "format": "uuid" },
    "hypothesis_ref": { "$ref": "https://ag47.protocol/schemas/common/artifact-reference" },
    "current_architecture_ref": { "$ref": "https://ag47.protocol/schemas/common/artifact-reference" },
    "target_architecture_ref": { "$ref": "https://ag47.protocol/schemas/common/artifact-reference" },
    "affected_modules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prohibited_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "planned_operations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test_plan": { "type": "string" },
    "rollback_plan": { "type": "string" },
    "change_budget_ref": { "$ref": "https://ag47.protocol/schemas/common/artifact-reference" },
    "expected_human_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "architecture_impact": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "migrations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "approvals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "PROPOSED", "APPROVED", "REJECTED", "ACTIVE", "COMPLETED", "CANCELLED", "SUPERSEDED"]
    }
  },
  "required": [
    "changeset_id", "hypothesis_ref", "allowed_paths", "prohibited_paths",
    "acceptance_criteria", "rollback_plan", "change_budget_ref", "status"
  ]
}
