{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.protocol/schemas/validation/approval-record",
  "title": "Approval Record",
  "description": "Explicit decision about an artifact mapped by hash.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approval_id": { "type": "string", "format": "uuid" },
    "subject_ref": { "$ref": "https://ag47.protocol/schemas/common/artifact-reference" },
    "approval_type": {
      "type": "string",
      "enum": ["PLAN_APPROVAL", "ARCHITECTURE_APPROVAL", "MERGE_APPROVAL", "RELEASE_APPROVAL", "ROLLBACK_APPROVAL", "HUMAN_ACTION_CONFIRMATION"]
    },
    "decision": {
      "type": "string",
      "enum": ["APPROVED", "APPROVED_WITH_CONDITIONS", "REJECTED", "REVOKED", "EXPIRED"]
    },
    "actor_signature": { "$ref": "https://ag47.protocol/schemas/common/artifact-reference" },
    "conditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "comments": { "type": "string" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revoked_at": { "type": "string", "format": "date-time" },
    "supersedes": { "$ref": "https://ag47.protocol/schemas/common/artifact-reference" },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "REVOKED", "EXPIRED", "SUPERSEDED"]
    }
  },
  "required": [
    "approval_id", "subject_ref", "approval_type", "decision",
    "actor_signature", "issued_at", "status"
  ]
}
