{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag47.protocol/schemas/validation/evidence-bundle",
  "title": "Evidence Bundle",
  "description": "A verifiable collection of evidence items.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bundle_id": { "type": "string", "format": "uuid" },
    "subject_refs": {
      "type": "array",
      "items": { "$ref": "https://ag47.protocol/schemas/common/artifact-reference" }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "generated_by": { "type": "string" },
    "evidence_items": {
      "type": "array",
      "items": { "$ref": "https://ag47.protocol/schemas/common/evidence-item" }
    },
    "integrity": { "type": "string" },
    "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
    "expiration": { "type": "string", "format": "date-time" },
    "confidence": { "type": "number", "enum": [0.0, 0.25, 0.5, 0.75, 1.0] }
  },
  "required": [
    "bundle_id", "subject_refs", "generated_at", "generated_by",
    "evidence_items", "integrity", "completeness"
  ]
}
