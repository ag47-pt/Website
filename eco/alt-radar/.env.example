# Variáveis compartilhadas pelo Docker Compose local.
# Para `npm run dev`, copie também os exemplos dentro de apps/api e apps/web.

AG47_DEMO_MODE=true
AG47_AUTO_SEED_DEMO=true

# URL visível no browser apenas no Compose local (web :3000 -> API :8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

POSTGRES_DB=ag47_radar
POSTGRES_USER=ag47
POSTGRES_PASSWORD=ag47_local_only
