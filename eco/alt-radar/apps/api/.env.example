# Runtime
AG47_ENVIRONMENT=development
AG47_DEBUG=false
AG47_DEMO_MODE=true
AG47_LOG_LEVEL=INFO
AG47_DATABASE_URL=sqlite+aiosqlite:///./data/ag47_radar.db
AG47_DATABASE_POOL_SIZE=20
AG47_DATABASE_MAX_OVERFLOW=10
AG47_DATABASE_POOL_TIMEOUT=30.0
AG47_AUTO_CREATE_SCHEMA=true
AG47_AUTO_SEED_DEMO=true
AG47_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production must run Alembic as a release step; the API ignores AUTO_CREATE_SCHEMA there.
# Set operator/admin keys only through the deployment secret store. Production fails closed without them.
AG47_OPERATOR_API_KEY=
AG47_ADMIN_API_KEY=
# Comma-separated CIDRs of the reverse proxies allowed to supply X-Forwarded-For.
AG47_TRUSTED_PROXY_CIDRS=
# Comma-separated HTTPS webhook hostnames permitted in production.
AG47_WEBHOOK_ALLOWED_HOSTS=

# Provider resilience. No API keys are required for Sprint 1 public providers.
AG47_PROVIDER_TIMEOUT_SECONDS=8
AG47_PROVIDER_MAX_RETRIES=2
AG47_PROVIDER_BACKOFF_SECONDS=0.35
AG47_PROVIDER_CACHE_TTL_SECONDS=60
AG47_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
AG47_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=45

# Periodic ingestion is opt-in. Demo and real data are never merged.
AG47_SCHEDULER_ENABLED=false
AG47_SCHEDULER_INTERVAL_SECONDS=300

# Per-process mutation protection for the local MVP.
AG47_MUTATION_RATE_LIMIT_REQUESTS=20
AG47_MUTATION_RATE_LIMIT_WINDOW_SECONDS=60
AG47_ALERT_DEDUPLICATION_WINDOW_MINUTES=30
